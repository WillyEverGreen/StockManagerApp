{
  "expo": {
    "name": "StockManager",
    "slug": "stockmanager-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow StockManager to access your camera to scan barcodes."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stockmanager.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow StockManager to access your camera to scan barcodes."
      }
    },
    "android": {
      "package": "com.stockmanager.app",
      "permissions": ["CAMERA"]
    }
  }
}
